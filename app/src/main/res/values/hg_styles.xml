<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Kartu umum -->
    <style name="HgCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/hg_surface</item>
        <item name="strokeColor">@color/hg_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Judul bagian -->
    <style name="HgSection">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hg_text</item>
    </style>

    <!-- Keterangan kecil -->
    <style name="HgLabel">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/hg_text_muted</item>
    </style>

    <!-- Angka atau nilai utama -->
    <style name="HgValue">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hg_text</item>
    </style>

    <!-- Nama perangkat atau judul baris -->
    <style name="HgName">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hg_text</item>
    </style>

    <!-- Judul halaman pada toolbar sederhana -->
    <style name="HgTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/hg_text</item>
    </style>

</resources>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <FrameLayout
        android:id="@+id/wrapPanduan"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_icon_neutral">

        <ImageView
            android:id="@+id/ivPanduan"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_nav_beranda"
            app:tint="@color/hg_info" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvPanduanJudul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="Judul"
        android:textColor="@color/hg_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPanduanIsi"
        style="@style/HgLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Keterangan"
        android:textSize="15sp" />
</LinearLayout>

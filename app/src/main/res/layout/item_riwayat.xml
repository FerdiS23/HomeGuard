<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/kartuItem"
    style="@style/HgCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/wrapItem"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_icon_neutral">

            <ImageView
                android:id="@+id/ivItem"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                app:tint="@color/hg_text_muted" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemJudul"
                style="@style/HgName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Peringatan" />

            <TextView
                android:id="@+id/tvItemPesan"
                style="@style/HgLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Keterangan"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvItemWaktu"
                style="@style/HgLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Waktu"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

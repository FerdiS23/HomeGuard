<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Lokasi: dipakai untuk geofence "dekat rumah" dan "mode pergi" -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        android:minSdkVersion="29" />

    <!-- Notifikasi peringatan (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Layanan latar agar peringatan tetap masuk saat aplikasi ditutup -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Kunci aplikasi dengan sidik jari / wajah -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomeGuard">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- ===================== HALAMAN ===================== -->

        <!-- Pintu masuk aplikasi: panduan awal / kunci / beranda -->
        <activity
            android:name=".PembukaActivity"
            android:exported="true"
            android:theme="@style/Theme.HomeGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Halaman 1-4: beranda, riwayat, statistik, pengaturan (navigasi bawah) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman 5: panduan awal -->
        <activity
            android:name=".PanduanActivity"
            android:exported="false" />

        <!-- Halaman 6: kunci aplikasi -->
        <activity
            android:name=".KunciActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman 7: pengaturan server MQTT -->
        <activity
            android:name=".ServerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman 8: pengaturan rumah -->
        <activity
            android:name=".RumahActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ===================== LAYANAN & PENERIMA ===================== -->

        <service
            android:name=".HomeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".GeofenceReceiver"
            android:exported="false" />

        <receiver
            android:name=".NotifActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
